{
  "name": "breeze-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "translations:build": "node scripts/build-translations.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": "vitest run --reporter=verbose __tests__",
    "*.test.{js,mjs}": "vitest run --reporter=verbose __tests__"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
